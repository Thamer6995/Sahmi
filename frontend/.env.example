# قيم مشروع Firebase العلنية (تُؤخذ من إعدادات المشروع في Firebase Console)
# هذه ليست أسرارًا حساسة، لكن ضع القيم الحقيقية في .env.local فقط ولا ترفعها لأي مستودع عام.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# رابط الخادم الخلفي المنشور على Render (بدون شرطة مائلة في النهاية)
VITE_BACKEND_URL=https://your-app.onrender.com

# وضع التطوير: يُظهر صفحة /dev-test لاختبار الاتصال بـ SAHMK وTelegram
VITE_DEV_MODE=false
