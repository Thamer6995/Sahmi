# قيم مشروع Firebase العلنية (تُؤخذ من إعدادات المشروع في Firebase Console)
# هذه ليست أسرارًا حساسة، لكن ضع القيم الحقيقية في .env.local فقط ولا ترفعها لأي مستودع عام.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
