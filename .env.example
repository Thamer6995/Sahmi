# =============================================================================
# سهمي (Sahmi) - نموذج متغيرات البيئة
# لا تضع أي قيم حقيقية في هذا الملف. انسخه إلى .env محليًا فقط لأغراض
# محاكي Firebase (emulator) في مرحلة التطوير.
#
# في الإنتاج: لا تستخدم .env إطلاقًا لأي سر. استخدم Firebase Secrets:
#   firebase functions:secrets:set SAHMK_API_KEY
#   firebase functions:secrets:set TELEGRAM_BOT_TOKEN
#   firebase functions:secrets:set TELEGRAM_CHAT_ID
# =============================================================================

# ---- SAHMK API (Backend فقط - Functions) ----
# مفتاح API الخاص بباقة Starter من https://www.sahmk.sa/en/developers
SAHMK_API_KEY=

# Base URL الرسمي لـ SAHMK API (لا تغيّره إلا إذا تغيّر في الوثائق الرسمية)
SAHMK_BASE_URL=https://app.sahmk.sa/api/v1

# ---- Telegram Bot (Backend فقط - Functions) ----
# التوكن الذي يعطيك إياه @BotFather بعد إنشاء البوت
TELEGRAM_BOT_TOKEN=

# معرف المحادثة (Chat ID) الذي سيستقبل التنبيهات
TELEGRAM_CHAT_ID=

# ---- Firebase Project (Frontend + Functions) ----
FIREBASE_PROJECT_ID=

# ---- إعدادات عامة ----
# المنطقة الزمنية المستخدمة في كل الجدولة والعرض
APP_TIMEZONE=Asia/Riyadh

# وضع التطوير: يتحكم في السماح بعرض Raw API Response لأغراض المراجعة فقط
# اجعلها false قبل أي نشر للإنتاج
DEV_MODE=true
