rules_version = '2';

// سهمي - Firestore Security Rules
// التطبيق شخصي بحساب واحد فقط: أي طلب من العميل (Frontend) يجب أن يكون
// مصادقًا (auth != null). كل الكتابة الفعلية للبيانات (companies, quotes,
// financials...) تتم من Cloud Functions عبر Admin SDK الذي يتجاوز هذه
// القواعد، لذا نمنع الكتابة المباشرة من العميل لكل الـ collections
// التشغيلية، ونسمح فقط بالقراءة، وبكتابة محدودة لما يخص تفضيلات المستخدم
// الشخصية (watchlist notes/settings) عبر واجهات محكومة لاحقًا إن لزم.

function isSignedIn() {
  return request.auth != null;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // بيانات القراءة فقط من العميل - الكتابة حصرًا من Functions (Admin SDK)
    match /companies/{symbol} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /quotes/{symbol} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /historicalPrices/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /financials/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /ratios/{symbol} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /dividends/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /scores/{symbol} {
      allow read: if isSignedIn();
      allow write: if false;

      // سجل تغيّر التقييم (subcollection) - يُعرض في صفحة السهم
      match /history/{historyId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // watchlist: يُدار عبر Callable Functions للتحقق من صحة المدخلات،
    // لكن نسمح بقراءة/كتابة مباشرة للمستخدم المصادق نظرًا لأن التطبيق
    // شخصي بحساب واحد ولا تحتاج ملاحظاته/سعره المستهدف تحققًا من الخادم.
    match /watchlist/{symbol} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // أي مسار غير معرف صراحة: ممنوع تمامًا
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
